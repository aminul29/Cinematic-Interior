{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1480px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "obsidian",
          "color": "#0c0d0e",
          "name": "Obsidian Dark"
        },
        {
          "slug": "surface",
          "color": "#141618",
          "name": "Deep Surface"
        },
        {
          "slug": "surface-light",
          "color": "#1f2226",
          "name": "Surface Light"
        },
        {
          "slug": "taupe",
          "color": "#2a2725",
          "name": "Architectural Taupe"
        },
        {
          "slug": "gold",
          "color": "#c9a25e",
          "name": "Champagne Gold"
        },
        {
          "slug": "gold-light",
          "color": "#e0be7d",
          "name": "Gold Light"
        },
        {
          "slug": "white",
          "color": "#f5f5f7",
          "name": "Gallery White"
        },
        {
          "slug": "muted",
          "color": "rgba(245, 245, 247, 0.65)",
          "name": "Muted White"
        },
        {
          "slug": "subtle",
          "color": "rgba(245, 245, 247, 0.40)",
          "name": "Subtle White"
        },
        {
          "slug": "border",
          "color": "rgba(201, 162, 94, 0.16)",
          "name": "Gold Border"
        }
      ],
      "gradients": [
        {
          "slug": "gold-radial",
          "gradient": "radial-gradient(circle at center, rgba(201, 162, 94, 0.22) 0%, rgba(12, 13, 14, 0) 70%)",
          "name": "Gold Ambient Radial"
        },
        {
          "slug": "surface-gradient",
          "gradient": "linear-gradient(180deg, #141618 0%, #0c0d0e 100%)",
          "name": "Surface Fade"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "name": "Playfair Display",
          "slug": "heading"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Plus Jakarta Sans",
          "slug": "body"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1.0625rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.375rem",
          "slug": "large"
        },
        {
          "name": "X-Large",
          "size": "clamp(1.75rem, 3.5vw, 2.75rem)",
          "slug": "x-large"
        },
        {
          "name": "Hero Headline",
          "size": "clamp(2.5rem, 6.5vw, 5.5rem)",
          "slug": "hero"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "name": "1", "size": "0.5rem", "slug": "10" },
        { "name": "2", "size": "1rem", "slug": "20" },
        { "name": "3", "size": "1.5rem", "slug": "30" },
        { "name": "4", "size": "2.5rem", "slug": "40" },
        { "name": "5", "size": "4rem", "slug": "50" },
        { "name": "6", "size": "6.5rem", "slug": "60" }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "0"
    },
    "color": {
      "background": "var(--wp--preset--color--obsidian)",
      "text": "var(--wp--preset--color--white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.15"
        },
        "color": {
          "text": "var(--wp--preset--color--white)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--gold)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--gold-light)"
          }
        }
      }
    }
  }
}
